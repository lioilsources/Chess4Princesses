      "lines": {
        "attack": {
          "cs": "Píchnu tě!",
          "en": "Poke!"
        },
        "defeat": {
          "cs": "Utíkám do pekla na buchty…",
          "en": "Running home for buns…"
        },
        "victory": {
          "cs": "Bleee, vyhrál jsem!",
          "en": "Bleh, I won!"
        }
      }
    }

      },
      "lines": {
        "attack": {
          "cs": "Bubli-bubli!",
          "en": "Bubble-bubble!"
        },
        "defeat": {
          "cs": "Pára mi došla…",
          "en": "Out of steam…"
        },
        "victory": {
          "cs": "Syčí a bublá!",
          "en": "Hiss and bubble!"
        }
      }
    },
    "bishop": {
      "sprite": "sprites/bishop.webp",
      "name": {
        "cs": "Písař Brko",
        "en": "Quill the Scribe"
      },
      "motto": {
        "cs": "Ahoj, já jsem Písař Brko. Všechno si zapíšu brkem do pytle. Chodím jen šikmo.",
        "en": "Hi, I'm Quill the Scribe. I write everything down with my quill. I only go on the slant."
      },
      "lines": {
        "attack": {
          "cs": "Čmáry čmáry!",
          "en": "Scribble-scribble!"
        },
        "defeat": {
          "cs": "Zapíšu si to…",
          "en": "I'll write that down…"
        },
        "victory": {
          "cs": "Hotovo, podepsáno!",
          "en": "Done and signed!"
        }
      }
    },
    "knight": {
      "sprite": "sprites/knight.webp",
      "name": {
        "cs": "Kozlík Zvoneček",
        "en": "Jingle Goat"
      },
      "motto": {
        "cs": "Ahoj, já jsem Kozlík Zvoneček. Mám zvoneček a rohy jako preclík. Skáču do písmene L a přeskočím cokoli!",
        "en": "Hi, I'm Jingle Goat. I have a little bell and horns like pretzels. I jump in an L and hop over anything!"
      },
      "lines": {
        "attack": {
          "cs": "Mééé, hop!",
          "en": "Maa, hop!"
        },
        "defeat": {
          "cs": "Jdu se napást…",
          "en": "Off to graze…"
        },
        "victory": {
          "cs": "Cinky-cink!",
          "en": "Jingle-jingle!"
        }
      }
    },
    "pawn": {
      "sprite": "sprites/pawn.webp",
      "name": {
        "cs": "Čertík Vidlička",
        "en": "Forky"
      },
      "motto": {
        "cs": "Ahoj, já jsem Čertík Vidlička. Mám malé vidle a vyplazený jazýček. Chodím jen dopředu a jednou budu královna!",
        "en": "Hi, I'm Forky. I have a tiny pitchfork and stick out my tongue. I only walk forward, and one day I'll be a queen!"

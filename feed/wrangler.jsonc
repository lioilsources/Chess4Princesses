{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "princesschess-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "routes": [{ "pattern": "feed.ol1n.com", "custom_domain": true }],
  "vars": {
    "SOURCE_BASE": "https://lichess.org"
  }
}
